# vim: filetype=bash

alias vim="nvim"

tm() {
  # tmux mangles '.' and ':' in session names, so swap them out
  local session_name
  session_name=$(basename "$PWD" | tr '.:' '__')

  # -A attaches if the session already exists, creates it otherwise
  tmux new-session -A -s "$session_name"
}

sshz_hosts() {
  grep -h 'Host ' ~/.ssh/config* | grep -vF '*' | sed 's/^Host //' | fzf
}

sshz() {
  local endpoint
  endpoint=$(sshz_hosts)
  if [ -z "$endpoint" ]; then
    echo "No host selected."
    return 1
  fi

  echo "$endpoint"
  ssh "$endpoint"
}

sshz_install() {
  if [ -n "$1" ] && [ -f "$1" ]; then
    local key endpoint
    key=$1
    endpoint=$(sshz_hosts)
    if [ -z "$endpoint" ]; then
      echo "No host selected."
      return 1
    fi

    echo "$key"
    echo "$endpoint"

    ssh-copy-id -i "$key" "$endpoint"
  else
    echo "Please specify a key file as your argument"
    return 1
  fi
}

# Remove all local branches that aren't the default branch
git_prune() {
  # Ensure you are in a git repository
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: This is not a Git repository."
    return 1
  fi

  # Figure out the default branch (main, master, ...)
  local default_branch
  default_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
  if [ -z "$default_branch" ]; then
    echo "Error: Could not determine the default branch. Try: git remote set-head origin --auto"
    return 1
  fi

  # Check if on the default branch
  local current_branch
  current_branch=$(git branch --show-current)
  if [ "$current_branch" != "$default_branch" ]; then
    echo "Switching to $default_branch..."
    git checkout "$default_branch" || { echo "Failed to switch to $default_branch."; return 1; }
  fi

  # Fetch and prune remote-tracking branches
  echo "Fetching and pruning remote-tracking branches..."
  git fetch --prune

  # List all local branches except the default branch
  local branches_to_delete
  branches_to_delete=$(git for-each-ref --format='%(refname:short)' refs/heads | grep -vx "$default_branch")

  if [ -z "$branches_to_delete" ]; then
    echo "No local branches to delete."
    return 0
  fi

  # Confirm deletion
  echo "The following local branches will be force-deleted (including unmerged work):"
  echo "$branches_to_delete"
  echo -n "Are you sure? (y/N): "
  local confirmation
  read -r confirmation
  if [[ "$confirmation" =~ ^[Yy]$ ]]; then
    echo "$branches_to_delete" | xargs git branch -D
    echo "Deleted the branches."
  else
    echo "Operation canceled."
  fi
}
